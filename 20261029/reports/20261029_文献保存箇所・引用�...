    function renderTable(list) {
      const tbody = document.getElementById('tableBody');
      tbody.innerHTML = '';
      list.forEach(r => {
        const tr = document.createElement('tr');
        let badgeClass = 'badge-a';
        if (r.group.startsWith('B')) badgeClass = 'badge-b';
        if (r.group.startsWith('C')) badgeClass = 'badge-c';

        tr.innerHTML = `
          <td><span class="badge ${badgeClass}">${r.group.split(' ')[0]}</span></td>
          <td><strong>${r.id}</strong></td>
          <td><strong>${r.key}</strong><br><small style="color:#666;">${r.author} (${r.year})</small></td>
          <td>${r.title}<br><small style="color:#005BAC; font-weight:700;">${r.category}</small></td>
          <td>${r.in_draft}</td>
          <td><code style="font-size:12px;">${r.pdf_location}</code></td>
          <td><small>${r.excel_sheet}</small></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterTable() {
      const kw = document.getElementById('searchInput').value.toLowerCase().trim();
      const filtered = DATA.filter(r => {
        return !kw ||
          r.key.toLowerCase().includes(kw) ||
          r.author.toLowerCase().includes(kw) ||
          r.title.toLowerCase().includes(kw) ||
          r.group.toLowerCase().includes(kw) ||
          r.pdf_location.toLowerCase().includes(kw) ||
          r.excel_sheet.toLowerCase().includes(kw);
      });
      renderTable(filtered);
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderTable(DATA);
    });
  </script>
</body>
</html>
