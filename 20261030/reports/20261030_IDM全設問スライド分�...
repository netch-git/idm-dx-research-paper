            </div>
          </article>
        `;
      }

      allGrid.innerHTML = slidesData.map((s, idx) => cardHTML(s, idx)).join('');

      let gIdx = 0;
      groupsMap.forEach((items, groupName) => {
        const gId = `grp-sec-${gIdx}`;
