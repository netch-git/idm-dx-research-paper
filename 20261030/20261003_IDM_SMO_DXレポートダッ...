<script>
  // 全設問を1ページ1問の印刷用構造として一括構築する関数
  function buildAllPrintPages() {
    const container = document.getElementById('idm-print-all-pages');
    if (!container) return;
    if (container.children.length > 0) return; // 構築済みなら再利用

    if (typeof slidesData === 'undefined' || !Array.isArray(slidesData) || slidesData.length === 0) {
      console.warn("slidesDataが見つかりません。");
      return;
    }

    const total = slidesData.length;
    let html = '';

    slidesData.forEach((s, idx) => {
      const svgCode = (typeof idmGenerateSVG === 'function') 
        ? idmGenerateSVG(s, 760) 
        : ((typeof generateSlideSVG === 'function') ? generateSlideSVG(s, 760) : '');

      html += `
        <article class="idm-print-page">
          <div class="idm-print-header">
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 8.5pt; margin-bottom: 1mm;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-weight: 700; color: #004098; background: #eef2f6; border: 1px solid #d9d9d9; padding: 1px 6px; border-radius: 3px;">${s.group || ''}</span>
                <span style="font-weight: 700; color: #004098;">${s.title || ''}</span>
              </div>
              <span style="font-weight: 700; color: #4d4d4d;">No. ${idx + 1} / ${total}</span>
            </div>
            <h2 class="idm-print-stat">${s.stat || ''}</h2>
