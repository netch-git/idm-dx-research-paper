    // switchViewModeのグローバル確実バインド＆スタイル同期
    window.switchViewMode = function(mode) {
      const slidePane = document.getElementById('slidePane');
      const analysisPane = document.getElementById('analysisPane');
      const btnSplit = document.getElementById('btnViewSplit');
      const btnSlide = document.getElementById('btnViewSlide');
      const btnDash = document.getElementById('btnViewDashboard');
      const btnPaper = document.getElementById('btnViewPaper');

      [btnSplit, btnSlide, btnDash, btnPaper].forEach(btn => {
        if (btn) {
          btn.classList.remove('bg-da-primary', 'text-white', 'shadow-xs', 'font-bold');
          btn.classList.add('text-slate-300');
        }
      });

      if (mode === 'split') {
        if (btnSplit) btnSplit.classList.add('bg-da-primary', 'text-white', 'shadow-xs', 'font-bold');
        if (slidePane) { slidePane.classList.remove('hidden', 'w-full'); slidePane.classList.add('md:w-1/2'); }
        if (analysisPane) { analysisPane.classList.remove('hidden', 'w-full'); analysisPane.classList.add('flex-1'); }
      } else if (mode === 'slide') {
        if (btnSlide) btnSlide.classList.add('bg-da-primary', 'text-white', 'shadow-xs', 'font-bold');
        if (slidePane) { slidePane.classList.remove('hidden', 'md:w-1/2'); slidePane.classList.add('w-full'); }
        if (analysisPane) analysisPane.classList.add('hidden');
      } else if (mode === 'dashboard') {
        if (btnDash) btnDash.classList.add('bg-da-primary', 'text-white', 'shadow-xs', 'font-bold');
        if (slidePane) slidePane.classList.add('hidden');
        if (analysisPane) { analysisPane.classList.remove('hidden', 'md:w-1/2'); analysisPane.classList.add('w-full'); }
        if (typeof window.switchAnalysisTab === 'function') window.switchAnalysisTab('dashboard');
      } else if (mode === 'paper') {
        if (btnPaper) btnPaper.classList.add('bg-da-primary', 'text-white', 'shadow-xs', 'font-bold');
        if (slidePane) slidePane.classList.add('hidden');
        if (analysisPane) { analysisPane.classList.remove('hidden', 'md:w-1/2'); analysisPane.classList.add('w-full'); }
        if (typeof window.switchAnalysisTab === 'function') window.switchAnalysisTab('paper');
      }

      if (typeof window.triggerChartsResize === 'function') {
        setTimeout(window.triggerChartsResize, 200);
      }
    };

    // 初回ロード時初期化
    window.addEventListener('DOMContentLoaded', () => {
      idmBuildGrids();
      idmRenderSlide(0);
    });
