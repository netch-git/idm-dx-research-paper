    function updateSlideView() {
      for (let i = 1; i <= totalSlides; i++) {
        const el = document.getElementById('slideView' + i);
        if (el) {
          el.classList.add('hidden');
          el.classList.remove('block');
        }
      }
      const currentEl = document.getElementById('slideView' + currentSlide);
      if (currentEl) {
        currentEl.classList.remove('hidden');
        currentEl.classList.add('block');
      }

      document.getElementById('slideIndicator').textContent = `Slide ${currentSlide} / ${totalSlides}`;
      document.getElementById('slideSelect').value = currentSlide;

      const thumbs = document.querySelectorAll('.thumb-btn');
      thumbs.forEach((th, idx) => {
        if (idx + 1 === currentSlide) {
          th.classList.add('border-indigo-500', 'border-2');
          th.classList.remove('border-slate-700', 'border');
        } else {
          th.classList.remove('border-indigo-500', 'border-2');
          th.classList.add('border-slate-700', 'border');
        }
      });
    }

    function goToSlide(num) {
      if (num >= 1 && num <= totalSlides) {
        currentSlide = num;
        updateSlideView();
      }
    }

    function nextSlide() {
      if (currentSlide < totalSlides) {
        currentSlide++;
        updateSlideView();
      }
    }

    function prevSlide() {
      if (currentSlide > 1) {
        currentSlide--;
        updateSlideView();
      }
    }

    function toggleThumbnails() {
      const strip = document.getElementById('thumbnailStrip');
      strip.classList.toggle('hidden');
    }

    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        nextSlide();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        prevSlide();
      }
    });

