    // グローバルポータル切替の拡張 (idm, dx, eda)
    window.switchGlobalPortalView = function(target) {
      const secIDM = document.getElementById('sectionIDM');
      const secDX = document.getElementById('sectionDX');
      const secEDA = document.getElementById('sectionEDA');
      const btnIDM = document.getElementById('btnToggleIDM');
      const btnDX = document.getElementById('btnToggleDX');
      const btnEDA = document.getElementById('btnToggleEDA');

      [btnIDM, btnDX, btnEDA].forEach(b => {
        if (b) {
          b.classList.remove('dads-toggle-active');
          b.classList.remove('bg-da-primary', 'text-white');
          b.classList.add('text-da-text', 'hover:text-da-primary');
          b.setAttribute('aria-selected', 'false');
        }
      });
      if (secIDM) { secIDM.classList.remove('block'); secIDM.classList.add('hidden'); }
      if (secDX) { secDX.classList.remove('block'); secDX.classList.add('hidden'); }
      if (secEDA) { secEDA.classList.remove('block'); secEDA.classList.add('hidden'); }

      if (target === 'idm') {
        secIDM.classList.remove('hidden');
        secIDM.classList.add('block');
        if (btnIDM) { btnIDM.classList.add('dads-toggle-active'); btnIDM.setAttribute('aria-selected', 'true'); }
        document.body.style.backgroundColor = '#f5f7fa';
      } else if (target === 'dx') {
        secDX.classList.remove('hidden');
        secDX.classList.add('block');
        if (btnDX) { btnDX.classList.add('dads-toggle-active'); btnDX.setAttribute('aria-selected', 'true'); }
        document.body.style.backgroundColor = '#0f172a';
        if (typeof window.triggerChartsResize === 'function') setTimeout(window.triggerChartsResize, 150);
      } else if (target === 'eda') {
        secEDA.classList.remove('hidden');
        secEDA.classList.add('block');
        if (btnEDA) { btnEDA.classList.add('dads-toggle-active'); btnEDA.setAttribute('aria-selected', 'true'); }
        document.body.style.backgroundColor = '#f5f7fa';
      }
    };

