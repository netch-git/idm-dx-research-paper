    function updateBarriersChart() {
      const mode = document.getElementById('barrierScaleSelect').value;
      if (mode === 'grouped') {
        chartInstMap.barriers.data.datasets = groups.map((g, idx) => ({
          label: g.name,
          data: sc20Data.map(d => d.values[idx]),
          backgroundColor: g.color,
          borderRadius: 4
        }));
      } else if (mode === 'smo_vs_large') {
        const smoAvg = sc20Data.map(d => (d.values[0]*297 + d.values[1]*511 + d.values[2]*481) / 1289);
        const lgeAvg = sc20Data.map(d => (d.values[3]*31 + d.values[4]*295 + d.values[5]*419) / 745);
        chartInstMap.barriers.data.datasets = [
          { label: 'SMO 全体平均 (N=1,289)', data: smoAvg, backgroundColor: '#6366f1', borderRadius: 4 },
          { label: '大企業 全体平均 (N=745)', data: lgeAvg, backgroundColor: '#0ea5e9', borderRadius: 4 }
        ];
      } else if (mode === 'exec_vs_staff') {
        const execAvg = sc20Data.map(d => (d.values[0]*297 + d.values[3]*31) / 328);
        const staffAvg = sc20Data.map(d => (d.values[2]*481 + d.values[5]*419) / 900);
        chartInstMap.barriers.data.datasets = [
          { label: '経営層 全体平均 (N=328)', data: execAvg, backgroundColor: '#e11d48', borderRadius: 4 },
          { label: '一般社員 全体平均 (N=900)', data: staffAvg, backgroundColor: '#059669', borderRadius: 4 }
        ];
      }
      chartInstMap.barriers.update();
    }

