  // 印刷ボタンのオーバーライド（全設問生成を保証して印刷ダイアログを起動）
  window.addEventListener('DOMContentLoaded', () => {
    // 印刷直前に全ページ生成を実行
    window.addEventListener('beforeprint', buildAllPrintPages);

    // 画面上の全「印刷 / PDF」ボタンへのイベントバインド
    document.querySelectorAll("button").forEach(btn => {
      if (btn.textContent && (btn.textContent.includes("印刷") || btn.textContent.includes("PDF"))) {
        btn.setAttribute("onclick", "executePrintAllPDF()");
      }
    });
  });

  window.executePrintAllPDF = function() {
    buildAllPrintPages();
    setTimeout(() => {
      window.print();
    }, 150);
  };
