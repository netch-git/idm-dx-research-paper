    /* 5. ANOVA Table Populate */
    function populateAnovaTable() {
      const tbody = document.getElementById('anovaTableBody');
      let html = '';

      const appendSection = (title, items) => {
        html += `<tr class="bg-slate-100/80 font-sans font-bold text-slate-800"><td colspan="10" class="py-2 px-3">${title}</td></tr>`;
        items.forEach(d => {
          html += `<tr class="hover:bg-slate-50 transition-colors">
            <td class="py-2 px-3 font-sans text-slate-800 font-medium">${d.label}</td>
            <td class="py-2 px-2 text-center text-rose-600">${d.values[0].toFixed(2)}</td>
            <td class="py-2 px-2 text-center text-sky-600">${d.values[1].toFixed(2)}</td>
            <td class="py-2 px-2 text-center text-emerald-600">${d.values[2].toFixed(2)}</td>
            <td class="py-2 px-2 text-center text-rose-700 font-bold">${d.values[3].toFixed(2)}</td>
            <td class="py-2 px-2 text-center text-sky-700">${d.values[4].toFixed(2)}</td>
            <td class="py-2 px-2 text-center text-emerald-700">${d.values[5].toFixed(2)}</td>
            <td class="py-2 px-2 text-center font-bold ${d.fOrg.includes('*') ? 'text-indigo-600' : 'text-slate-400'}">${d.fOrg}</td>
            <td class="py-2 px-2 text-center font-bold ${d.fPos.includes('*') ? 'text-indigo-600' : 'text-slate-400'}">${d.fPos}</td>
            <td class="py-2 px-2 text-center font-bold ${d.fInt.includes('*') ? 'text-amber-600' : 'text-slate-400'}">${d.fInt}</td>
          </tr>`;
        });
      };

      appendSection('【SC18】DX推進認識・リーダーシップ評価 (5点満点)', sc18Data);
      appendSection('【SC20】DX推進における課題認識 (5点満点)', sc20Data);
      appendSection('【SC15】現場の効率化に対する懸念・抵抗要因 (5点満点)', sc15Data);

