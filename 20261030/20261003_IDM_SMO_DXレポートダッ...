    /* 1. Radar Chart */
    function initRadarChart() {
      const ctx = document.getElementById('radarChart').getContext('2d');
      const labels = sc18Data.map(d => d.label.split('. ')[1]);

      chartInstMap.radar = new Chart(ctx, {
        type: 'radar',
        data: { labels: labels, datasets: [] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          elements: { line: { borderWidth: 2.5 } },
          scales: {
            r: {
              min: 2.5,
              max: 4.5,
              ticks: { stepSize: 0.5, backdropColor: 'transparent', font: { size: 10 } },
              pointLabels: { font: { size: 10.5, weight: '600' }, color: '#334155' },
              grid: { color: '#e2e8f0' }
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)} 点`
              }
            }
          }
        }
      });
      updateRadarChart();
    }

    function updateRadarChart() {
      const mode = document.getElementById('radarFilterSelect').value;
      let selectedIndices = [];

      if (mode === 'smo_all') selectedIndices = [0, 1, 2];
      else if (mode === 'large_all') selectedIndices = [3, 4, 5];
      else if (mode === 'exec_vs_staff') selectedIndices = [0, 2, 3, 5];
      else selectedIndices = [0, 1, 2, 3, 4, 5];

      const datasets = selectedIndices.map(idx => {
        const g = groups[idx];
        return {
          label: g.name,
          data: sc18Data.map(d => d.values[idx]),
          borderColor: g.color,
          backgroundColor: g.bg,
          pointBackgroundColor: g.color,
          pointRadius: 4,
          pointHoverRadius: 6
        };
      });

      chartInstMap.radar.data.datasets = datasets;
      chartInstMap.radar.update();

      const badgesContainer = document.getElementById('radarLegendBadges');
      badgesContainer.innerHTML = selectedIndices.map(idx => {
        const g = groups[idx];
        return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-700 text-xs">
          <span class="w-2.5 h-2.5 rounded-full" style="background-color:${g.color}"></span>
          ${g.name} (N=${g.n})
        </span>`;
      }).join('');
    }

    /* 2. Leadership Bar Chart */
    function initLeadershipBarChart() {
      const ctx = document.getElementById('leadershipBarChart').getContext('2d');
      const labels = sc18Data.map(d => d.label);

      chartInstMap.leadership = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: groups.map((g, idx) => ({
            label: g.name,
            data: sc18Data.map(d => d.values[idx]),
            backgroundColor: g.color,
            borderRadius: 4
          }))
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: {
              min: 2.0,
              max: 4.5,
              title: { display: true, text: '平均スコア（5点満点）', font: { size: 11 } },
              grid: { color: '#f1f5f9' }
            },
            y: { ticks: { font: { size: 10.5 }, color: '#1e293b' }, grid: { display: false } }
          },
          plugins: {
            legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10.5 } } },
            tooltip: { callbacks: { label: (ctx) => `${ctx.dataset.label}: ${ctx.raw.toFixed(2)} 点` } }
          }
        }
      });
    }

    function sortLeadership(mode) {
      if (!chartInstMap.leadership) return;
      let sortedData = [...sc18Data];
      if (mode === 'gap') {
        sortedData.sort((a, b) => Math.abs(b.values[0] - b.values[2]) - Math.abs(a.values[0] - a.values[2]));
      }
      chartInstMap.leadership.data.labels = sortedData.map(d => d.label);
      groups.forEach((g, idx) => {
        chartInstMap.leadership.data.datasets[idx].data = sortedData.map(d => d.values[idx]);
      });
      chartInstMap.leadership.update();
    }

    /* 3. Barriers Bar Chart */
    function initBarriersChart() {
