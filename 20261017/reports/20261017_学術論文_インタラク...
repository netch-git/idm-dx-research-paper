        ctx.fillStyle = '#003E78';
        ctx.font = "800 12px 'Noto Sans JP', sans-serif";
        ctx.fillText("大企業: " + v.toFixed(3), px - 38, py - 12);
      });

      curSmo.forEach((v, i) => {
        const px = xPositions[i], py = yToPx(v);
        ctx.fillStyle = '#D32F2F';
        ctx.beginPath();
        ctx.moveTo(px, py - 7); ctx.lineTo(px + 7, py + 6); ctx.lineTo(px - 7, py + 6); ctx.closePath();
