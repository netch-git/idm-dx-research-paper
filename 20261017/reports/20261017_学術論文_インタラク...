      ctx.lineWidth = 4.5;
      ctx.beginPath();
      ctx.moveTo(xLeft, yToPx(yL));
      ctx.lineTo(xMid, yToPx(yM));
      ctx.lineTo(xRight, yToPx(yR));
      ctx.stroke();

      [[xLeft, yL], [xMid, yM], [xRight, yR]].forEach(pt => {
