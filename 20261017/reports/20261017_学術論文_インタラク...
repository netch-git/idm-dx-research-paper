        setKPI(2, "分配的公正 低認知オッズ比", "OR = " + orVal, ciTxt + " (p < 0.001)");
        setKPI(3, "クラスタ1 (変革牽引層)", "17.3% (352名)", "当事者意識 4.160 / 成果 5.812");
        setKPI(4, "クラスタ2 (受動的追随層)", "36.9% (750名)", "当事者意識 3.465 / 成果 5.215");
      } else if (mIdx === 3) {
        // Moderator W_centered sweeps from -0.730 (-1SD) to +0.730 (+1SD) as t goes 0 -> 1
        const wSD = lerp(-1.0, 1.0, t);
        const wCentered = wSD * 0.730;
        const slopeB = -0.0089 + 0.0826 * wCentered;
        const slopeSign = slopeB >= 0 ? "+" : "";
        setKPI(1, "手続的公正の水準 (W)", (wSD >= 0 ? "+" : "") + wSD.toFixed(2) + " SD", "実スコア換算: " + (3.095 + wCentered).toFixed(2) + "点");
        setKPI(2, "摩擦→当事者意識 条件付き傾き B", slopeSign + slopeB.toFixed(4), wSD < -0.4 ? "有意な負の関連 (p = 0.015*)" : (wSD > 0.4 ? "有意な正の関連 (p = 0.035*)" : "非有意・緩衝域 (ns)"));
        setKPI(3, "交互作用項 (摩擦 × 手続的公正)", "B = +0.0826***", "t = 3.66, p < 0.001");
