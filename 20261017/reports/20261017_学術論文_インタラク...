      { author: "Thibaut, J. W., & Walker, L. (1975)", title: "Procedural justice: A psychological analysis", journal: "L. Erlbaum Associates", hypo: "H3 (手続的公正の古典)", role: "意思決定プロセスへの関与と手続的公正の心理学的基礎。", url: "" },
      { author: "Vial, G. (2019)", title: "Understanding digital transformation: A review and a research agenda", journal: "The Journal of Strategic Information Systems, 28(2), 118–144", hypo: "第1章 (DX概念定義)", role: "DXの包括的文献レビューと組織変革としての定義。", url: "https://doi.org/10.1016/j.jsis.2019.01.003" }
    ];

    // Deterministic pseudo-random generator (seed = 42) for N=2,035 representative cluster visualization
    function createSeededRandom(seed) {
      let s = seed % 2147483647;
      return function() {
        s = (s * 16807) % 2147483647;
        return (s - 1) / 2147483646;
      };
    }

    const rng = createSeededRandom(42);
    const CLUSTER_POINTS = [];
    // Generate 240 deterministic points matching exact proportions (17.3% C1, 36.9% C2, 45.8% C3)
    const cSpecs = [
      { id: 0, count: 42, cx: 4.160, cy: 3.059, sx: 0.32, sy: 0.35, color: '#228543' },
      { id: 1, count: 88, cx: 3.465, cy: 2.728, sx: 0.30, sy: 0.32, color: '#005BAC' },
      { id: 2, count: 110, cx: 2.790, cy: 3.374, sx: 0.36, sy: 0.38, color: '#D32F2F' }
    ];
    cSpecs.forEach(spec => {
      for (let i = 0; i < spec.count; i++) {
        const u1 = Math.max(0.0001, rng());
        const u2 = rng();
        const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
        const z1 = Math.sqrt(-2.0 * Math.log(u1)) * Math.sin(2.0 * Math.PI * u2);
        const tx = Math.max(1.2, Math.min(4.9, spec.cx + z0 * spec.sx));
        const ty = Math.max(1.2, Math.min(4.8, spec.cy + z1 * spec.sy));
        // Initial unclustered position centered around grand means (3.323, 3.081)
        const ix = 3.323 + (rng() - 0.5) * 1.6;
        const iy = 3.081 + (rng() - 0.5) * 1.6;
        CLUSTER_POINTS.push({ cluster: spec.id, ix, iy, tx, ty, color: spec.color });
      }
    });

    // =========================================================================
    // 2. STATE & SCRUBBING ENGINE
    // =========================================================================
    let globalProgress = 0; // 0 to 7000 (1000 per Moment)
    let isPlaying = false;
    let playSpeed = 1.0;
    let lastFrameTime = null;

    // Interactive scene-specific override states
    let sceneState = {
      m1ShowCI: true,
      m1ShowSC18_8: false,
      m2ModelMode: 'main', // 'main' (OR=3.951) or 'sens' (OR=2.409)
      m2DistScore: null,   // null = follow scrub, or 1.0..5.0
      m3ManualSD: null,    // null = follow scrub, or -1.5..+1.5
      m4ChartMode: 'auto', // 'auto', 'gap', 'reg'
      m6ChartMode: 'auto'  // 'auto', 'models', 'items'
    };

    function lerp(a, b, t) {
      return a + (b - a) * Math.max(0, Math.min(1, t));
    }

    function easeInOutCubic(t) {
      t = Math.max(0, Math.min(1, t));
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function subProgress(t, start, end) {
      if (t <= start) return 0;
      if (t >= end) return 1;
      return (t - start) / (end - start);
    }

    function getCurrentMomentIndex() {
      return Math.min(6, Math.floor(globalProgress / 1000));
    }

    function getLocalT() {
      const mIdx = getCurrentMomentIndex();
      return Math.max(0, Math.min(1, (globalProgress - mIdx * 1000) / 1000));
    }

    let lastRenderedMoment = -1;

    function updateScrubUI() {
      const mIdx = getCurrentMomentIndex();
      const localT = getLocalT();
      const meta = MOMENTS_META[mIdx];

      // Update Master Slider & Percentage
      document.getElementById('masterScrubSlider').value = Math.round(globalProgress);
      document.getElementById('globalPctReadout').textContent = (globalProgress / 70).toFixed(1) + '%';

      // Update Local Slider
      document.getElementById('localScrubSlider').value = Math.round(localT * 1000);
      document.getElementById('localPctLabel').textContent = Math.round(localT * 100) + '%';

      // Update Chapter Ribbon Pills & Progress Bars
      const pills = document.querySelectorAll('.chapter-pill');
      pills.forEach((pill, idx) => {
        pill.classList.toggle('active', idx === mIdx);
        const bar = document.getElementById('cpBar' + idx);
        if (bar) {
          if (idx < mIdx) bar.style.width = '100%';
          else if (idx === mIdx) bar.style.width = (localT * 100).toFixed(1) + '%';
          else bar.style.width = '0%';
        }
        const tick = document.getElementById('mTick' + idx);
        if (tick) tick.classList.toggle('active', idx === mIdx);
      });

      // Find current Phase
      let activePhase = meta.phases[0];
      let activePhaseIdx = 0;
      meta.phases.forEach((p, idx) => {
        if (localT >= p.range[0] && localT <= p.range[1]) {
          activePhase = p;
          activePhaseIdx = idx;
        }
      });

      document.getElementById('stageMomentTag').textContent = meta.tag;
      document.getElementById('stagePhaseTag').textContent = activePhase.label;
      document.getElementById('stageTitle').textContent = meta.title;
      document.getElementById('storyCallout').innerHTML = '<strong>' + activePhase.label + '：</strong>' + activePhase.desc;
      document.getElementById('methodNoteBox').innerHTML = '<strong>方法論的・統計的注記：</strong>' + meta.note;

      // Rebuild phase steps list & custom scene controls only when Moment changes
      if (lastRenderedMoment !== mIdx) {
        lastRenderedMoment = mIdx;
        renderPhaseStepsList(mIdx, activePhaseIdx);
        renderSceneCustomControls(mIdx);
      } else {
        const items = document.querySelectorAll('.phase-step-item');
        items.forEach((el, idx) => el.classList.toggle('active', idx === activePhaseIdx));
      }

      // Update dynamic KPIs and draw Canvas
      updateLiveKPIs(mIdx, localT);
      drawCurrentMomentCanvas(mIdx, localT);
    }

