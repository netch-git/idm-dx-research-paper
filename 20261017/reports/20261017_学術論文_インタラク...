      const yMin = 3.24, yMax = 3.44;
      const yToPx = v => padT + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
      const xLeft = padL + plotW * 0.12;
      const xMid  = padL + plotW * 0.50;
      const xRight = padL + plotW * 0.88;

