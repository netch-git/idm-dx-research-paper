        drawRoundRect(ctx, mx - 85, yTop - 32, 170, (yBot - yTop) + 66, 8);
        ctx.fill();
        ctx.strokeStyle = '#D32F2F';
        ctx.setLineDash([4, 3]);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = '#D32F2F';
        ctx.font = "800 11.5px 'Noto Sans JP', sans-serif";
        ctx.textAlign = 'center';
        ctx.fillText("中間管理職 差 -0.094点*", mx, yBot + 42);
        ctx.fillText("(t = 2.075, p = 0.038, d = 0.154)", mx, yBot + 57);

