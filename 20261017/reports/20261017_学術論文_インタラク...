      ctx.fillStyle = '#FFFFFF';
      ctx.strokeStyle = activeColor;
      ctx.lineWidth = 2;
      drawRoundRect(ctx, padL + 16, padT + 8, 320, 52, 8);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = activeColor;
      ctx.font = "800 12.5px 'Noto Sans JP', sans-serif";
      ctx.fillText("現在の手続的公正水準: " + (wSD >= 0 ? "+" : "") + wSD.toFixed(2) + " SD", padL + 28, padT + 28);
      ctx.fillStyle = '#1A1A1A';
      ctx.font = "700 12px 'Noto Sans JP', sans-serif";
      ctx.fillText("条件付き単純傾斜 B = " + (slopeB >= 0 ? "+" : "") + slopeB.toFixed(4) + " (交互作用 B = +0.0826***)", padL + 28, padT + 48);
    }

