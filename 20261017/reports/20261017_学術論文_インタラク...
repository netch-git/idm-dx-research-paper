        ctx.beginPath(); ctx.moveTo(padL, py); ctx.lineTo(W - padR, py); ctx.stroke();
        ctx.fillStyle = '#4A5568';
        ctx.font = "700 11px 'Noto Sans JP', sans-serif";
        ctx.fillText(v.toFixed(2), 18, py + 4);
      });

      const xLabels = ["低摩擦 (-1SD: 2.45)", "平均摩擦 (3.08)", "高摩擦 (+1SD: 3.71)"];
      [xLeft, xMid, xRight].forEach((px, i) => {
        ctx.fillStyle = '#1A1A1A';
        ctx.font = "800 12px 'Noto Sans JP', sans-serif";
        ctx.textAlign = 'center';
        ctx.fillText(xLabels[i], px, H - 18);
      });
      ctx.textAlign = 'left';

      // Reference Ghost Lines: Low (-1SD: [3.385, 3.341, 3.298]) and High (+1SD: [3.310, 3.342, 3.375])
      ctx.save();
      ctx.setLineDash([5, 4]);
      ctx.lineWidth = 2;
      // Ghost Low (-1SD)
      ctx.strokeStyle = 'rgba(211, 47, 47, 0.35)';
      ctx.beginPath();
      ctx.moveTo(xLeft, yToPx(3.385)); ctx.lineTo(xMid, yToPx(3.341)); ctx.lineTo(xRight, yToPx(3.298));
      ctx.stroke();
      ctx.fillStyle = 'rgba(211, 47, 47, 0.65)';
      ctx.font = "700 11px 'Noto Sans JP', sans-serif";
      ctx.fillText("低手続的公正 (-1SD): B = -0.0692*", xRight - 175, yToPx(3.298) + 18);

      // Ghost High (+1SD)
      ctx.strokeStyle = 'rgba(0, 91, 172, 0.35)';
      ctx.beginPath();
      ctx.moveTo(xLeft, yToPx(3.310)); ctx.lineTo(xMid, yToPx(3.342)); ctx.lineTo(xRight, yToPx(3.375));
      ctx.stroke();
      ctx.fillStyle = 'rgba(0, 91, 172, 0.65)';
      ctx.fillText("高手続的公正 (+1SD): B = +0.0515*", xRight - 175, yToPx(3.375) - 10);
      ctx.restore();

      // Active Interpolated Line based on t (0 = -1SD, 0.5 = Mean, 1.0 = +1SD)
      const yL = lerp(3.385, 3.310, t);
      const yM = lerp(3.341, 3.342, t);
      const yR = lerp(3.298, 3.375, t);
      const wSD = lerp(-1.0, 1.0, t);
      const slopeB = -0.0089 + 0.0826 * (wSD * 0.730);

      const activeColor = wSD < -0.25 ? '#D32F2F' : (wSD > 0.25 ? '#005BAC' : '#00838F');
