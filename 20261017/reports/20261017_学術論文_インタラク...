    // =========================================================================
    // 5. PLAYBACK LOOP & TIMELINE HANDLERS
    // =========================================================================
    function onMasterScrub(val) {
      if (isPlaying) stopPlay();
      globalProgress = parseFloat(val);
      updateScrubUI();
    }

    function onLocalScrub(val) {
      if (isPlaying) stopPlay();
      const mIdx = getCurrentMomentIndex();
      globalProgress = mIdx * 1000 + Math.min(999, parseFloat(val));
      updateScrubUI();
    }

    function jumpToMoment(mIdx) {
      globalProgress = mIdx * 1000;
      updateScrubUI();
    }

    function jumpToMomentAndSwitch(mIdx) {
      switchView('scrub');
      globalProgress = mIdx * 1000 + 850; // Jump into key reveal state of that moment
      updateScrubUI();
    }

    function stepMoment(delta) {
      if (isPlaying) stopPlay();
      const nextM = Math.max(0, Math.min(6, getCurrentMomentIndex() + delta));
      globalProgress = nextM * 1000;
      updateScrubUI();
    }

    function togglePlay() {
      if (isPlaying) {
        stopPlay();
      } else {
        if (globalProgress >= 6995) globalProgress = 0;
        isPlaying = true;
        lastFrameTime = performance.now();
        document.getElementById('btnPlayPause').textContent = '⏸ 一時停止';
        requestAnimationFrame(tickPlayback);
      }
    }

    function stopPlay() {
      isPlaying = false;
      document.getElementById('btnPlayPause').textContent = '▶ 自動再生';
    }

    function setPlaySpeed(spd) {
      playSpeed = parseFloat(spd);
    }

    function tickPlayback(now) {
      if (!isPlaying) return;
      const dt = (now - lastFrameTime) / 1000;
      lastFrameTime = now;
      // Full 7 moments in ~35 seconds at 1x speed (200 units per second)
      globalProgress += dt * 200 * playSpeed;
      if (globalProgress >= 7000) {
        globalProgress = 7000;
        updateScrubUI();
        stopPlay();
        return;
      }
      updateScrubUI();
      requestAnimationFrame(tickPlayback);
    }

