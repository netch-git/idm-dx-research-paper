    function setSimCell(scale, hier) {
      simScale = scale;
      simHier = hier;
      ['L0','L1','L2','S0','S1','S2'].forEach(k => {
        const el = document.getElementById('simCell-' + k);
        if (el) el.classList.toggle('active', k === scale + hier);
      });
      updateSimulator();
    }

    function updateSimulator() {
      const key = simScale + simHier;
      const cell = CELL_STATS[key];
      document.getElementById('simCellLabel').textContent = cell.label;

      const dist = parseFloat(document.getElementById('simDistSlider').value) / 100;
      const proc = parseFloat(document.getElementById('simProcSlider').value) / 100;
      const fric = parseFloat(document.getElementById('simFricSlider').value) / 100;
      const pmo  = parseFloat(document.getElementById('simPmoSlider').value) / 100;
      const tech = parseFloat(document.getElementById('simTechSlider').value) / 100;

      document.getElementById('simDistVal').textContent = dist.toFixed(2) + " 点";
      document.getElementById('simProcVal').textContent = proc.toFixed(2) + " 点";
      document.getElementById('simFricVal').textContent = fric.toFixed(2) + " 点";
      document.getElementById('simPmoVal').textContent  = "PMO " + pmo.toFixed(2) + " / 技術 " + tech.toFixed(2);

      // H1 Cell Mean
      document.getElementById('simOutH1').textContent = cell.m.toFixed(3) + " " + cell.ci;
      document.getElementById('simBarH1').style.width = ((cell.m / 5.0) * 100).toFixed(1) + '%';

      // H2 Logistic Regression Model 2 (Table 4-5)
      // Low distributive justice score = (5 - dist)
      const lowDist = 5.0 - dist;
      const bScale = simScale === 'L' ? -0.129 : 0;
      const bHier = simHier === 1 ? 0.625 : (simHier === 2 ? 1.007 : 0);
      const logit = -3.287 + bScale + bHier + 1.373 * lowDist;
      const probC3 = 1 / (1 + Math.exp(-logit));
      const pctC3 = (probC3 * 100).toFixed(1);
      document.getElementById('simOutH2').textContent = pctC3 + "% (OR = 3.951 / 感度分析 OR = 2.409)";
      document.getElementById('simBarH2').style.width = pctC3 + '%';

      // H3 Moderated Regression (Table 4-6)
      const fricC = fric - 3.081;
      const procC = proc - 3.095;
      const condSlope = -0.0089 + 0.0826 * procC;
      const yHatH3 = Math.max(1.0, Math.min(5.0, 3.341 - 0.0089 * fricC + 0.5649 * procC + 0.0826 * fricC * procC));
      document.getElementById('simOutH3').textContent = yHatH3.toFixed(3) + " 点 (条件付き傾き B = " + (condSlope >= 0 ? "+" : "") + condSlope.toFixed(4) + ")";
      document.getElementById('simBarH3').style.width = ((yHatH3 / 5.0) * 100).toFixed(1) + '%';

      // H4 Multiple Regression for Q4 (Table 4-9, Age=53.4, Male reference)
      const bLargeQ4 = simScale === 'L' ? 0.2695 : 0;
      const bHierQ4 = simHier === 1 ? 0.0045 : (simHier === 2 ? -0.0591 : 0);
      const q4Pred = Math.max(0, Math.min(10, 2.2590 - 0.0040 * 53.4 + bLargeQ4 + bHierQ4 + 0.0819 * tech + 0.9255 * pmo));
      document.getElementById('simOutH4').textContent = q4Pred.toFixed(2) + " 点 / 10点 (PMO β = 0.439***)";
      document.getElementById('simBarH4').style.width = (q4Pred * 10).toFixed(1) + '%';

      // H5 Gap
      document.getElementById('simOutH5').textContent = "+" + cell.gap.toFixed(3) + " 点 (正比率 " + cell.pos + ")";
      document.getElementById('simBarH5').style.width = Math.min(100, (cell.gap / 2.0) * 100).toFixed(1) + '%';

      document.getElementById('simInterpretationBox').innerHTML =
        '<strong>シミュレーション診断：</strong>選択中の「' + cell.label + '」において、分配的公正が <strong>' + dist.toFixed(2) + '点</strong> のとき、低当事者意識・高摩擦群（クラスタ3）への所属予測確率は <strong>' + pctC3 + '%</strong> です。また、PMO機能充足度（<strong>' + pmo.toFixed(2) + '点</strong>）はデジタル技術知識（<strong>' + tech.toFixed(2) + '点</strong>）の約9.3倍の標準化効果（β = 0.439 vs 0.047）でDX成果実感（予測値 <strong>' + q4Pred.toFixed(2) + '点</strong>）と関連しています。';
    }

