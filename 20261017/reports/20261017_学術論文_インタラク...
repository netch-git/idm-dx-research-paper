    // -------------------------------------------------------------------------
    function drawMoment3(ctx, W, H, t) {
      const padL = 64, padR = 36, padT = 48, padB = 56;
      const plotW = W - padL - padR;
      const plotH = H - padT - padB;

      ctx.fillStyle = '#003E78';
