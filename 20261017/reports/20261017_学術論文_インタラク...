    let simScale = 'S'; // 'L' (大企業) or 'S' (SMO)
    let simHier = 1;    // 0 (経営層), 1 (中間管理職), 2 (一般社員)

    const CELL_STATS = {
      'L0': { label: '大企業 × 役員・経営層 (n=31)', m: 3.852, ci: '[3.642, 4.061]', gap: 1.677, pos: '51.6%' },
