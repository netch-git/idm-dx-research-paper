        setKPI(3, "SC18-8 経営層リーダーシップ", "F = 5.57**", "Holm補正後 p = 0.0342* (唯一有意)");
        setKPI(4, "SC18-8 管理職スコア比較", "3.25 vs 2.87", "大企業管理職 3.25 / SMO管理職 2.87");
      }
    }

    // =========================================================================
    // 4. HIGH-DPI HTML5 CANVAS RENDERER FOR ALL 7 MOMENTS
    // =========================================================================
    function drawCurrentMomentCanvas(mIdx, localT) {
      const canvas = document.getElementById('scrubCanvas');
      if (!canvas) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const W = rect.width;
      const H = rect.height;
      if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) {
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
      }
      const ctx = canvas.getContext('2d');
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, W, H);

      // Subtle background grid
      ctx.strokeStyle = '#EDF2F7';
      ctx.lineWidth = 1;
      for (let x = 40; x < W; x += 40) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
      }
      for (let y = 40; y < H; y += 40) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
      }

      if (mIdx === 0) drawMoment0(ctx, W, H, localT);
      else if (mIdx === 1) drawMoment1(ctx, W, H, localT);
      else if (mIdx === 2) drawMoment2(ctx, W, H, localT);
      else if (mIdx === 3) drawMoment3(ctx, W, H, localT);
      else if (mIdx === 4) drawMoment4(ctx, W, H, localT);
      else if (mIdx === 5) drawMoment5(ctx, W, H, localT);
      else if (mIdx === 6) drawMoment6(ctx, W, H, localT);

      ctx.restore();
    }

    function drawRoundRect(ctx, x, y, w, h, r) {
      const radius = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + w - radius, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
      ctx.lineTo(x + w, y + h - radius);
      ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
      ctx.lineTo(x + radius, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    // -------------------------------------------------------------------------
    // MOMENT 0: Screening Funnel (8,608 -> 2,035) & 6-Cell Breakdown
    // -------------------------------------------------------------------------
    function drawMoment0(ctx, W, H, t) {
      const stages = [
        { label: "初期回収: SC調査モニター総数", rem: 8608, drop: 0, note: "100.0%", thresh: 0.0 },
        { label: "第1段階 (SC1): 非就業者を除外", rem: 8274, drop: -334, note: "96.1%", thresh: 0.12 },
        { label: "第2段階 (SC7): 役職不明を除外", rem: 8149, drop: -125, note: "94.7%", thresh: 0.25 },
        { label: "第3段階 (SC17): DX未認知者を除外", rem: 4222, drop: -3927, note: "49.0%", thresh: 0.45 },
        { label: "第4段階-A (SC19): DX未取組企業除外", rem: 2845, drop: -1377, note: "33.1%", thresh: 0.65 },
        { label: "第4段階-B: 確定有効本調査標本", rem: 2035, drop: -810, note: "23.6% (確定)", thresh: 0.82 }
      ];

      ctx.fillStyle = '#003E78';
      ctx.font = "800 13.5px 'Noto Sans JP', sans-serif";
      ctx.fillText("▼ スクリーニング4段階除外プロセス（横棒ファネル比較：N = 8,608 → 2,035）", 18, 26);

      const leftPad = Math.min(240, W * 0.36);
      const maxBarW = W - leftPad - 95;
      const startY = 42;
      const rowH = t > 0.72 ? 32 : 46;

      stages.forEach((st, idx) => {
        const y = startY + idx * rowH;
        const activeP = easeInOutCubic(subProgress(t, st.thresh, st.thresh + 0.16));
        const barW = Math.max(4, (st.rem / 8608) * maxBarW * (idx === 0 ? 1 : activeP));

        ctx.fillStyle = idx === 5 ? '#003E78' : '#2D3748';
        ctx.font = (idx === 5 ? "800 " : "700 ") + "12px 'Noto Sans JP', sans-serif";
        ctx.fillText(st.label, 18, y + 16);

        // Background track
        ctx.fillStyle = '#E2E8F0';
