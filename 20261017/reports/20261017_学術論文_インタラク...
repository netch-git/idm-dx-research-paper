      document.getElementById('kpi' + idx + 'Sub').textContent = sub;
    }

    function updateLiveKPIs(mIdx, t) {
      if (mIdx === 0) {
        let rem = 8608;
        if (t < 0.2) rem = Math.round(lerp(8608, 8149, t / 0.2));
        else if (t < 0.5) rem = Math.round(lerp(8149, 4222, (t - 0.2) / 0.3));
        else if (t < 0.75) rem = Math.round(lerp(4222, 2845, (t - 0.5) / 0.25));
        else rem = Math.round(lerp(2845, 2035, (t - 0.75) / 0.25));
