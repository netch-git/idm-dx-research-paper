    function renderLitList() {
      const q = (document.getElementById('litSearchBox')?.value || '').toLowerCase();
      const container = document.getElementById('litGridContainer');
      if (!container) return;
      container.innerHTML = '';
      const filtered = LIT_LIST.filter(item =>
        !q ||
        item.author.toLowerCase().includes(q) ||
        item.title.toLowerCase().includes(q) ||
        item.hypo.toLowerCase().includes(q) ||
        item.role.toLowerCase().includes(q)
      );
      filtered.forEach(item => {
        const div = document.createElement('div');
        div.className = 'lit-card';
        div.innerHTML =
          '<div>' +
            '<div style="display:flex; justify-content:space-between; align-items:center; gap:6px; margin-bottom:4px;">' +
              '<span class="lit-author">' + item.author + '</span>' +
              '<span style="font-size:11px; font-weight:800; background:#E8F2FC; color:#005BAC; padding:2px 6px; border-radius:4px;">' + item.hypo + '</span>' +
            '</div>' +
            '<div style="font-size:13px; font-weight:700; color:#2D3748; margin-bottom:4px;">' + item.title + '</div>' +
            '<div style="font-size:12px; font-style:italic; color:#718096; margin-bottom:8px;">' + item.journal + '</div>' +
            '<div class="lit-role">' + item.role + '</div>' +
          '</div>' +
          '<div style="text-align:right; font-size:12px;">' +
            (item.url ? '<a href="' + item.url + '" target="_blank" rel="noopener" style="color:#005BAC; font-weight:800; text-decoration:none;">🔗 DOI / 公式リンク</a>' : '<span style="color:#A0AEC0;">書籍 / 公的統計白書</span>') +
          '</div>';
        container.appendChild(div);
      });
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    window.addEventListener('keydown', e => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT')) return;
      if (e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        if (e.shiftKey) stepMoment(1);
        else {
          if (isPlaying) stopPlay();
          globalProgress = Math.min(7000, globalProgress + 140);
          updateScrubUI();
        }
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        if (e.shiftKey) stepMoment(-1);
        else {
          if (isPlaying) stopPlay();
          globalProgress = Math.max(0, globalProgress - 140);
          updateScrubUI();
        }
      } else if (e.key === 'f' || e.key === 'F') {
        e.preventDefault();
        toggleFullscreen();
      } else if (e.key >= '1' && e.key <= '7') {
        jumpToMoment(parseInt(e.key, 10) - 1);
      }
    });

    window.addEventListener('resize', () => {
      updateScrubUI();
    });

    window.addEventListener('DOMContentLoaded', () => {
      updateScrubUI();
      updateSimulator();
      renderLitList();
    });
  </script>
</body>
</html>
